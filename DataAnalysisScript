# ---- MARGINAL PROBABILITIES OF GUIDELINE ADHERENCE -----------------------

get_marginal_table <- function(model, model_name) {
  probs <- avg_predictions(model, variables = "drug_assoc")
  diff  <- avg_comparisons(model, variables = "drug_assoc")
  
  OR_info <- tidy(model, conf.int = TRUE, exponentiate = TRUE) %>%
    filter(term == "drug_assocYes")
  
  tibble(
    Model = model_name,
    Non_DA = probs$estimate[probs$drug_assoc == "No"],
    DA = probs$estimate[probs$drug_assoc == "Yes"],
    Difference = diff$estimate,
    Lower_CI = diff$conf.low,
    Upper_CI = diff$conf.high,
    OR = OR_info$estimate,
    OR_lower = OR_info$conf.low,
    OR_upper = OR_info$conf.high,
    p_value = OR_info$p.value
  )
}

model_unadj <- glm(guideline_adherent ~ drug_assoc, family = binomial, data = data_guidadh)

marginal_results <- bind_rows(
  get_marginal_table(model_unadj, "Unadjusted"),
  get_marginal_table(model_minimal, "Minimal"),
  get_marginal_table(model_full, "Full")
)

marginal_results_formatted <- marginal_results %>%
  mutate(
    Non_DA = scales::percent(Non_DA, accuracy = 0.1),
    DA = scales::percent(DA, accuracy = 0.1),
    Difference = scales::percent(Difference, accuracy = 0.1),
    CI = paste0(scales::percent(Lower_CI, accuracy = 0.1), " to ",
                scales::percent(Upper_CI, accuracy = 0.1)),
    `OR (95% CI)` = paste0(round(OR, 2), " (", round(OR_lower, 2), ", ", round(OR_upper, 2), ")"),
    `p-value` = ifelse(p_value < 0.001, "<0.001", sprintf("%.3f", p_value))
  ) %>%
  select(Model, Non_DA, DA, Difference, CI, `OR (95% CI)`, `p-value`)

