# ---- GUIDELINE ADHERENCE DEFINITION & CHI-SQUARE TEST --------------------
# Adherent = >=2 poor-prognosis findings AND death >=3 days post-ROSC

data_guidadh <- data_plotrosc %>%
  mutate(guideline_adherent = if_else(
    n_findings >= 2 & rosc_to_outcome_days >= 3, "Adherent", "Non-adherent"
  ))

