data <- data %>%
  mutate(
    ca_datetime = as.POSIXct(paste(ca_date, ca_time),
                             format = "%Y-%m-%d %H:%M:%S"),
    dispatch_datetime = as.POSIXct(paste(ca_date, dispatch_time),
                                   format = "%Y-%m-%d %H:%M:%S"),
    rosc_datetime = as.POSIXct(paste(ca_date, first_rosc),
                               format = "%Y-%m-%d %H:%M:%S")
  )

# Adjust for midnight crossover
data <- data %>%
  mutate(
    dispatch_datetime = if_else(
      !is.na(dispatch_datetime) & !is.na(ca_datetime) &
        as.numeric(difftime(dispatch_datetime, ca_datetime, units = "hours")) > 12,
      dispatch_datetime - 86400,
      dispatch_datetime
    ),
    rosc_datetime = if_else(
      !is.na(rosc_datetime) & !is.na(ca_datetime) &
        as.numeric(difftime(ca_datetime, rosc_datetime, units = "hours")) > 12,
      rosc_datetime + 86400,
      rosc_datetime
    )
  )

# Time intervals
data <- data %>%
  mutate(
    time_to_rosc      = as.numeric(difftime(rosc_datetime, ca_datetime, units = "mins")),
    dispatch_to_rosc   = as.numeric(difftime(rosc_datetime, dispatch_datetime, units = "mins")),
    rosc_to_outcome    = as.numeric(difftime(outcome_datetime, rosc_datetime, units = "hours"))
