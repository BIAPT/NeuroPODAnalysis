# ---- LOGISTIC REGRESSION: GUIDELINE ADHERENCE ----------------------------
# Final model set: unadjusted, minimally adjusted, fully adjusted

data_guidadh <- data_guidadh %>%
  mutate(
    guideline_adherent = factor(guideline_adherent, levels = c("Non-adherent", "Adherent")),
    drug_assoc = factor(drug_assoc, levels = c("No", "Yes")),
    sex = factor(sex, levels = c("Female", "Male")),
    ca_loc = factor(ca_loc, levels = c("Residential", "Non-Residential")),
    initial_rhythm = factor(initial_rhythm),
    witnessed = factor(witnessed),
    bys_cpr = factor(bys_cpr),
    hosp_site = factor(hosp_site),
    ca_yr = factor(ca_yr)
  )

# Unadjusted (one model per variable)
tbl_unadj <- tbl_uvregression(
  data = data_guidadh, method = glm, y = guideline_adherent,
  method.args = list(family = binomial), exponentiate = TRUE,
  include = c(drug_assoc, age, sex, ca_loc, initial_rhythm, witnessed, bys_cpr,
              ca_yr, hosp_site, dispatch_to_rosc)
) %>%
  bold_p() %>% bold_labels()

# Minimally adjusted: age, sex, hosp_site, ca_yr
model_minimal <- glm(
  guideline_adherent ~ drug_assoc + age + sex + hosp_site + ca_yr,
  data = data_guidadh, family = binomial
)
tbl_minimal <- tbl_regression(model_minimal, exponentiate = TRUE) %>%
  bold_p() %>% bold_labels()

# Fully adjusted
model_full <- glm(
  guideline_adherent ~ drug_assoc + age + sex + hosp_site + ca_yr + ca_loc +
    initial_rhythm + dispatch_to_rosc + witnessed + bys_cpr,
  data = data_guidadh, family = binomial
)
tbl_full <- tbl_regression(model_full, exponentiate = TRUE) %>%
  bold_p() %>% bold_labels()

final_table <- tbl_merge(
  tbls = list(tbl_unadj, tbl_minimal, tbl_full),
  tab_spanner = c("**Unadjusted OR**", "**Minimally Adjusted OR\u2020**", "**Fully Adjusted OR\u2021**")
) %>%
  modify_column_hide(columns = stat_n_1) %>%
  modify_caption("**Factors Associated with Guideline Adherence**")

