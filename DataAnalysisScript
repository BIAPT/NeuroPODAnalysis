# Coding legend:
# status:       factor (alive or deceased)
# hosp_adm:     0 = ER, 1 = ICU, 2 = CCU (/CICU/CTU/CSICU)
# ca_yr:        2024 or 2023
# sex:          0 = Female, 1 = Male
# ind_consult:  0 = No, 1 = Yes
# housing:      0 = Unstable, 1 = Stable, 2 = Unknown
# hist_drug:    0 = No, 1 = Yes, "Unknown" = Unknown
# drug_assoc:   0 = No, 1 = Yes
# witnessed:    0 = Unwitnessed, 1 = Witnessed by Bystander, 2 = Witnessed by EMS
# bys_cpr:      0 = No, 1 = Yes
# bys_type:     0 = Layperson, 1 = Police, 2 = Healthcare, 3 = Other, 4 = Unknown
# rearrest:     0 = No, 1 = Yes
# hosp_site:    0 = Site 1, 1 = Site 2
# gcs_icu:      0 = No, 1 = Yes
# pat_outcome:  0 = Alive, 1 = Deceased, 2 = Unknown
# cause_death:  0 = DNC, 1 = WLST, 2 = In the ER (pre-ICU)
# cpc_score:    1 = CPC1, 2 = CPC2, 3 = CPC3, 4 = CPC4, 5 = Unknown
# sdm_present:  0 = No, 1 = Yes
# sdm_type:     0 = None, 1 = Committee, 2 = Representative, 3 = Advance
